# Copy this file to `.env` and fill in your key:   cp .env.example .env
# Every notebook, app.py, jobs/ and scripts/ load it automatically (falls back to existing env vars).
# Check your setup with:   uv run python scripts/doctor.py

# --- ONE OpenRouter key drives both brains ---------------------------------------------
# Get one at https://openrouter.ai/keys
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-your-key-here

# Slow brain: any tool-capable chat model on OpenRouter.
MODEL=openai/gpt-6-luna
# The "capable" tier for routing (notebooks 02, 03, 08, 11).
#SMART_MODEL=openai/gpt-6-sol

# Fast brain: Jev via OpenRouter's System One endpoint (https://openrouter.ai/api/v1/systemone).
JEV_BACKEND=typesafe
JEV_MODEL=~typesafe/jev-latest
TYPESAFE_BASE_URL=https://openrouter.ai/api
# Defaults to OPENAI_API_KEY. Set it only if you use a separate key, e.g. a direct TypeSafe key:
#TYPESAFE_API_KEY=
#TYPESAFE_BASE_URL=https://api.typesafe.ai
#JEV_MODEL=jev-latest

# No Jev access yet? Same API, answered by your LLM via system-one-adapter (slower, but runs):
#JEV_BACKEND=adapter

# --- Optional: triage your real mailbox (notebook 04, jobs/email_triage.py) --------------
# READ-ONLY: the mailbox is opened with readonly=True and fetched with BODY.PEEK[]; nothing is sent.
# Use an app password (Gmail: Google Account > Security > App passwords).
#IMAP_HOST=imap.gmail.com
#IMAP_USER=you@gmail.com
#IMAP_PASSWORD=your-app-password

# --- TLS / firewall ------------------------------------------------------------------------
# Set to false ONLY behind a TLS-intercepting proxy where HTTPS verification fails.
VERIFY_SSL=true
